nce = parseInt(\"${e:\/\/Field\/Balance}\");\n\tif (balance < 0) {\n\tdocument.getElementById(\"balance\").style.color = \"red\";\n\t}\n\n});\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1KZjDQzAfdoOZfL","Element":"SQ","PrimaryAttribute":"QID157","SecondaryAttribute":"This is the end of the study. \u00a0 Your final balance in the household game was: \u00a3...","TertiaryAttribute":null,"Payload":{"QuestionText":"<w:sdt docpart=\"0046B62F439A46A189EF41FE4DFE2C7F\" id=\"-906842999\">\n<p><o:p><\/o:p><\/p>\n<\/w:sdt><w:sdt docpart=\"0046B62F439A46A189EF41FE4DFE2C7F\" id=\"-906842999\">\n<p>This is the end of the study.<\/p>\n\n<p>&nbsp;<\/p>\n<o:p><\/o:p><w:sdtpr>\n<p>Your final balance in the household game was: \u00a3${e:\/\/Field\/Balance}.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>This means you ${e:\/\/Field\/FeedbackReason} and your payment for this study will be \u00a3${e:\/\/Field\/PptPayment} (excluding potential payout for the second part of the study).<\/p>\n<\/w:sdtpr><\/w:sdt><w:sdt docpart=\"0046B62F439A46A189EF41FE4DFE2C7F\" id=\"-906842999\"> <\/w:sdt>","DefaultChoices":false,"DataExportTag":"END1","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the end of the study. \u00a0 Your final balance in the household game was: \u00a3...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID157","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_1KZjDQzAfdoOZfL","Element":"SQ","PrimaryAttribute":"QID318","SecondaryAttribute":"This is the end of the study. Thank you for participating! \u00a0 In this study, we are interested in...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>This is the end of the study. Thank you for participating!<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>In this study, we are interested in how people are affected by having different levels of financial resources. We wanted to know whether having a lot or very little money affects how people make financial decisions.&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>If you have any questions or complaints about this study, please contact Dr. M. K. Noordewier at Leiden University, The Netherlands, via <em>m.k.noordewier@fsw.leidenuniv.nl<\/em>.<\/p>\n\n<p>&nbsp;<\/p>\n\nYou will now be forwarded to prolific.","DefaultChoices":false,"DataExportTag":"END2","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the end of the study. Thank you for participating! \u00a0 In this study, we are interested in...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID318","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_1KZjDQzAfdoOZfL","Element":"SQ","PrimaryAttribute":"QID237","SecondaryAttribute":"This is the end of week ${e:\/\/Field\/IncomeRoundCounter}. \u00a0 Your current balance is:\u00a0\u00a3...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>This is the end of week ${e:\/\/Field\/IncomeRoundCounter}.<\/p>\n\n<p>&nbsp;<\/p>\n\n\n<div><strong><span id=\"balance1\" style=\"font-size:19px;\">Your current balance is:&nbsp;\u00a3${e:\/\/Field\/Balance}<\/span><\/strong><\/div>","DefaultChoices":false,"DataExportTag":"FB01.2","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This is the end of week ${e:\/\/Field\/IncomeRoundCounter}. \u00a0 Your current balance is:\u00a0\u00a3...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID237","DataVisibility":{"Pr
you to go totally without this product or service than have one with this feature level.","T_MostandLeastPreferred":"Please select your most preferred and least preferred for each set shown below:","T_PreferenceMostandLeast":"Considering the concepts you've just seen, please indicate your preference for the following:","T_ImportancesConstSum":"In the previous questions, you rated the following as your most preferred. Please allocate 100 percentage points showing the relative importance of each:","T_UpgradeConstSum":"Assume you are upgrading...please allocate 100 percentage points showing the relative importance of each upgrade:","DisplayOneAtATime":false,"Features":[],"ID":"CJ_0jHuxErOAQorNnD"}},{"SurveyID":"SV_1KZjDQzAfdoOZfL","Element":"SQ","PrimaryAttribute":"QID277","SecondaryAttribute":"Continue to start with your work shift.","TertiaryAttribute":null,"Payload":{"QuestionText":"Continue to start with your work shift.","DefaultChoices":false,"DataExportTag":"Exp1_tot","QuestionID":"QID277","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Continue to start with your work shift.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1}},{"SurveyID":"SV_1KZjDQzAfdoOZfL","Element":"SQ","PrimaryAttribute":"QID278","SecondaryAttribute":"Continue to start with your work shift.","TertiaryAttribute":null,"Payload":{"QuestionText":"Continue to start with your work shift.","DefaultChoices":false,"DataExportTag":"Exp6_tot","QuestionID":"QID278","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Continue to start with your work shift.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1}},{"SurveyID":"SV_1KZjDQz
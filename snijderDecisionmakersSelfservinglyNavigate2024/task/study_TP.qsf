a Multiplier of 1.3.&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"GRB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Type 2 Type 2 has an Income\u00a0of 75 units and a Multiplier of 1.3.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SubSelector":"WTXB","DataVisibility":{"Private":false,"Hidden":false},"Graphics":"IM_2ggzzKkrcaX7AaN","GraphicsDescription":"Dia2n","QuestionText_Unsafe":"<div><span style=\"font-size: 19.3333px;\"><strong>Type 2<\/strong><\/span><\/div><div><span style=\"font-size: 19.3333px;\"><strong><br><\/strong><\/span><\/div><div>Type 2 has an Income&nbsp;of 75 and a Multiplier of 1.3.&nbsp;<\/div>","DataExportTag":"Text","QuestionID":"QID529"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID530","SecondaryAttribute":"Type 3 Type 3 has an Income\u00a0of 25 units and a Multiplier of 1.7.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size: 19.3333px;\"><strong>Type 3<\/strong><\/span><\/div><div><span style=\"font-size: 19.3333px;\"><strong><br><\/strong><\/span><\/div><div>Type 3 has an Income&nbsp;of 25 units and a Multiplier of 1.7.&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"GRB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Type 3 Type 3 has an Income\u00a0of 25 units and a Multiplier of 1.7.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SubSelector":"WTXB","DataVisibility":{"Private":false,"Hidden":false},"Graphics":"IM_cwIyTVx3MrRUCUd","GraphicsDescription":"Dia3n","QuestionText_Unsafe":"<div><span style=\"font-size: 19.3333px;\"><strong>Type 3<\/strong><\/span><\/div><div><span style=\"font-size: 19.3333px;\"><strong><br><\/strong><\/span><\/div><div>Type 3 has an Income&nbsp;of 25 and a Multiplier of 1.7.&nbsp;<\/div>","DataExportTag":"Text","QuestionID":"QID530"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID531","SecondaryAttribute":"Type 4 Type 4 has an Income of 25 units and a Multiplier of 1.3.\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size: 19.3333px;\"><strong>Type 4<\/strong><\/span><\/div><div><span style=\"font-size: 19.3333px;\"><strong><br><\/strong><\/span><\/div><div>Type 4 has an Income of 25 units and a Multiplier of 1.3.&nbsp;<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"GRB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Type 4 Type 4 has an Income of 25 units and a Multiplier of 1.3.\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SubSelector":"WTXB","DataVisibility":{"Private":false,"Hidden":false},"Graphics":"IM_88qN43Xror7t8cR","GraphicsDescription":"Dia4n","QuestionText_Unsafe":"<div><span style=\"font-size: 19.3333px;\"><strong>Type 4<\/strong><\/span><\/div><div><span style=\"font-size: 19.3333px;\"><strong><br><\/strong><\/span><\/div><div>Type 4 has an Income of 25 and a Multiplier of 1.3.&nbsp;<\/div>","DataExportTag":"Text","QuestionID":"QID531"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID774","SecondaryAttribute":"Unfinished Types","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:19px;\"><strong>Unfinished Types<\/strong><\/span><\/div>","DefaultChoices":false,"DataExportTag":"Text","QuestionID":"QID774","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","NumColumns":2},"QuestionDescription":"Unfinished Types","ChoiceOrder":[],"Randomization":"All","Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":10}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID767","SecondaryAttribute":"Unfinished Types Why did you create the Types the way you did? Please select the option that appl...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><strong>Unfinished Types<\/strong><\/span><br \/>\n<br \/>\nWhy did you create the Types the way you did? Please select the option that applies best to your decision.","DefaultChoices":false,"DataExportTag":"createtype_MC","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Unfinished Types Why did you create the Types the way you did? Please select the option that appl...","Choices":{"4":{"Display":"Inequality - I wanted to reduce inequality between Types"},"5":{"Display":"Maximal benefit - I wanted to maximize (joint) possible outcomes"},"6":{"Display":"Similarity - I matched Incomes and Multipliers based on similarity (i.e., high to high and low to low)"},"7":{"Display":"Random - I randomly assigned Incomes and Multipliers"},"9":{"Display":"Other","TextEntry":"true","TextEntrySize":"Medium","TextEntryForceResponse":true}},"ChoiceOrder":["4","5","6","7","9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID767"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID1212729392","SecondaryAttribute":"Unfinished\u00a0Types \u00a0 In the current block you will see two \"unfinished\" Types. These Types miss the.","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size: 19.3333px;\"><strong>Unfinished&nbsp;<\/strong><\/span><span style=\"font-family: Helvetica, sans-serif; font-size: 19.3333px; font-weight: 700;\">Types<\/span><\/div>\n\n<div>&nbsp;<\/div>\nIn the current block you will see two &quot;unfinished&quot; Types. These Types miss their Income and Multiplier.&nbsp;\n\n<div>&nbsp;<\/div>\n\n<div>You are asked to create Types by assigning them an Income and Multiplier.<\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Unfinished\u00a0Types \u00a0 In the current block you will see two \"unfinished\" Types. These Types miss the...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<div><span style=\"font-size: 19.3333px;\"><strong>Unfinished&nbsp;<\/strong><\/span><span style=\"font-family: Helvetica, sans-serif; font-size: 19.3333px; font-weight: 700;\">Types<\/span><\/div>\n\n<div>&nbsp;<\/div>\nIn the current block you will see unfinished Types. These Types miss their Income or Multiplier.&nbsp;<div><br><\/div><div>You are asked to finish the Types by assigning them an Income or Multiplier according to what you consider to be right.<\/div>","DataExportTag":"Text","QuestionID":"QID1212729392"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID765","SecondaryAttribute":"Units are worth real money. All units will be exchanged to pounds and may be added to your additi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Units are worth real money. <\/strong>All units will be exchanged to pounds and may be added to your additional payment.<br \/>\n<br \/>\nThe conversion rate is: <strong>25 units = &pound;1.00.<\/strong>","DefaultChoices":false,"DataExportTag":"Text","QuestionID":"QID765","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Units are worth real money. All units will be exchanged to pounds and may be added to your additi...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID1212728685","SecondaryAttribute":"Welcome to our study! \u00a0 Thank you for your interest in this study. This study is being conducted...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><span style=\"font-size:22px;\"><strong>Welcome to our study!<\/strong><\/span><\/div>\n\n<div>&nbsp;<\/div>\n\n<p>Thank you for your interest in this study. This study is being conducted as part of a research project at Leiden University, The Netherlands. This is a study about decision-making. You will be asked to make decisions about some monetary divisions between yourself and other persons.<br>\n<br>\nThis study will take about <strong>40 minutes<\/strong> to complete. You will receive <strong>\u00a34.00&nbsp;for participation<\/strong> in this study + <strong>an additional payment of<\/strong>&nbsp;<strong>up to&nbsp;\u00a36.50<\/strong>.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><u>Before you start, it is important that you know that:<\/u><\/p>\n\n<ul>\n\t<li>This study falls under the no deception policy of Leiden University. This means that everything will happen as stated in the instructions. Your decisions and the decisions of other participants will have real consequences. Everything will be executed as stated in the instructions. There is no hidden information and no deception.<\/li>\n\t<li>We are interested in your decisions, so there are no right or wrong answers.<\/li>\n\t<li><strong>Your decisions will impact not only your own additional payment, but also the additional payment of others.<\/strong><\/li>\n\t<li>You participate voluntarily and you can stop participating at any time. Please do note that if you quit before the study is finished, we won\u2019t be able to pay you.<\/li>\n\t<li>All data will be stored in a coded way, so there is no way that the researchers can connect your answers to you personally. Your Prolific ID number will be removed from the data set after data collection is completed.<\/li>\n\t<li>All measures taken in this study are for scientific purposes only and the data are stored in a secured environment.<\/li>\n\t<li>You will be informed about the purpose of this study at the end.<\/li>\n<\/ul>\n\n<p><br>\n<u>Contact: <\/u><br>\nIf you have any questions or complaints about this study, please contact Luuk Snijder (l.snijder@fsw.leidenuniv.nl) or the principal investigator Mirre Stallen (m.stallen@fsw.leidenuniv.nl).<br>\n<br>\nFor questions on data privacy and protection, or if you would like to lodge a complaint concerning data privacy protection if you feel the need to do so, please contact our Data Privacy Officer (privacy@fsw.leidenuniv.nl; The Faculty of Social and Behavioral Sciences, Leiden University).<br>\n<br>\nIf you do not wish to participate, please close your web browser, and please return your submission on Prolific by selecting the 'Stop without completing' button.&nbsp;Thank you for considering participating.<\/p>\n\n<p><br>\n<u><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><span style=\"line-height:150%\"><u><span lang=\"EN-US\"><span style=\"line-height:150%\">Informed Consent \u2013 please tick all boxes to indicate your agreement:<\/span><\/span><\/u>&nbsp;<\/span><\/span><\/span><\/u><\/p>","DefaultChoices":false,"QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome to our study! \u00a0 Thank you for your interest in this study. This study is being conducted...","Choices":{"1":{"Display":"I have read the information letter for the participant. I could contact the researcher to ask additional questions. My questions have been answered adequately. I have had sufficient time to decide whether or not I participate."},"2":{"Display":"I am aware that participation is completely voluntary. I know that I can decide at any moment not to participate or to stop. I do not need to provide a reason for that."},"3":{"Display":"My responses are processed anonymously or in a coded way."},"4":{"Display":"I give consent to use my data for the purposes that are mentioned in the information letter."}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1212728685\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Welcome to our study! &nbsp; Thank you for your interest in this study. This study is being conducted...<\/span> <span class=\"LeftOpDesc\">I have read the information letter for the participant. I could contact the researcher to ask additional questions. My questions have been answered adequately. I have had sufficient time to decide whether or not I participate.<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1212728685\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1212728685","QuestionIDFromLocator":"QID1212728685","QuestionIsInLoop":"no","Type":"Expression"},"1":{"ChoiceLocator":"q:\/\/QID1212728685\/SelectableChoice\/2","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">Welcome to our study! &nbsp; Thank you for your interest in this study. This study is being conducted...<\/span> <span class=\"LeftOpDesc\">I am aware that participation is completely voluntary. I know that I can decide at any moment not to participate or to stop. I do not need to provide a reason for that.<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1212728685\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID1212728685","QuestionIDFromLocator":"QID1212728685","QuestionIsInLoop":"no","Type":"Expression"},"2":{"ChoiceLocator":"q:\/\/QID1212728685\/SelectableChoice\/3","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">Welcome to our study! &nbsp; Thank you for your interest in this study. This study is being conducted...<\/span> <span class=\"LeftOpDesc\">My responses are processed anonymously or in a coded way.<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1212728685\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID1212728685","QuestionIDFromLocator":"QID1212728685","QuestionIsInLoop":"no","Type":"Expression"},"3":{"ChoiceLocator":"q:\/\/QID1212728685\/SelectableChoice\/4","Conjuction":"And","Description":"<span class=\"ConjDesc\">And<\/span> <span class=\"QuestionDesc\">Welcome to our study! &nbsp; Thank you for your interest in this study. This study is being conducted...<\/span> <span class=\"LeftOpDesc\">I give consent to use my data for the purposes that are mentioned in the information letter.<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1212728685\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID1212728685","QuestionIDFromLocator":"QID1212728685","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Require all choice responses","libraryID":null,"messageID":null,"subMessageID":"VE_FORCE_RESPONSE_MORE"}}}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionText_Unsafe":"<div><span style=\"font-size:22px;\"><strong>Welcome to our study!<\/strong><\/span><\/div><div>&nbsp;<\/div><p>Thank you for your interest in this study. This study is being conducted as part of a research project at Leiden University and the University of Amsterdam, The Netherlands. This is a study about decision-making. You will be asked to make decisions about some monetary divisions between yourself and other persons.<br><br>This study will take about <strong>30&nbsp;minutes<\/strong> to complete. You will receive <strong>\u00a33.00&nbsp;for participation<\/strong> in this study + <strong>a possible&nbsp;bonus of<\/strong>&nbsp;<strong>up to&nbsp;\u00a35.00<\/strong>.<\/p><p>&nbsp;<\/p><p><u>Before you start, it is important that you know that:<\/u><\/p><ul><li>This study falls under the no deception policy of Leiden University. This means that everything will happen as stated in the instructions. Your decisions and the decisions of other participants will have real consequences. Everything will be executed as stated in the instructions. There is no hidden information and no deception.<\/li><li>We are interested in your decisions, so there are no right or wrong answers.<\/li><li><strong>Your decisions will impact not only your own bonus payment, but also the bonus payment of others.<\/strong><\/li><li>You participate voluntarily and you can stop participating at any time. Please do note that if you quit before the study is finished, we won\u2019t be able to pay you.<\/li><li>All data will be stored in a coded way, so there is no way that the researchers can connect your answers to you personally. Your Prolific ID number will be removed from the data set after data collection is completed.<\/li><li>The data are stored in a secured environment. <strong>Your data will be used for another study, in which we connect your data with data of other participants. Based on your decisions now, and of the other participants at a later time, you might receive a bonus payment, which will be paid out to you once the other study is finished.&nbsp;<\/strong><\/li><li>You will be informed about the purpose of this study at the end of the experiment.<\/li><\/ul><p><br><u>Contact: <\/u><br>If you have any questions or complaints about this study, please contact Luuk Snijder&nbsp;at Leiden University, the Netherlands (l.snijder@fsw.leidenuniv.nl).<br><br>If you have any questions about privacy and data protection, please contact our privacy officer Raymond van Erkel at Leiden University (r.van.erkel@fsw.leidenuniv.nl). This contact information will be provided again at the end of the study.<br><br>If you do not wish to participate, please close your web browser, and please return your submission on Prolific by selecting the 'Stop without completing' button.&nbsp;Thank you for considering participating.<\/p><p><br><u><span style=\"font-family:Arial,Helvetica,sans-serif;\"><span style=\"font-size:16px;\"><span style=\"line-height:150%\"><u><span lang=\"EN-US\"><span style=\"line-height:150%\">Informed Consent \u2013 please tick all boxes to indicate your agreement:<\/span><\/span><\/u>&nbsp;<\/span><\/span><\/span><\/u><\/p>","DataExportTag":"IC1","QuestionID":"QID1212728685"}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID919","SecondaryAttribute":"Welcome to our study! \u00a0 This experiment consists of one short allocation task (5-10 minutes), the..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Welcome to our study!<\/strong><br>\n&nbsp;\n<p>This experiment consists of one short allocation task (5-10 minutes), thereafter one main decision-making task (30 minutes), and finally one&nbsp;questionnaire (less than 5 minutes).<\/p>","DefaultChoices":false,"DataExportTag":"TEXT","QuestionID":"QID919","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome to our study! \u00a0 This experiment consists of one short allocation task (5-10 minutes), the...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_033u4aMDr5refGe","Element":"SQ","PrimaryAttribute":"QID343","SecondaryAttribute":"Welcome\u00a0to our study! \u00a0 Thank you for choosing to participate in this study.\u00a0 \u00a0 Please enter you","TertiaryAttribute":null,"Payload":{"QuestionTe